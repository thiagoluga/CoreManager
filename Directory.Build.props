<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Suppressed rules (pragmatic for this codebase):
      CA1014  — CLSCompliant attribute not required.
      CA1819  — properties returning array (needed for byte[] RowVersion in EF Core).
      CA2227  — collection setters (EF Core needs them to hydrate entities).
      CA1812  — class never instantiated (false positives with DI).
      CA1716  — name conflicts with VB.NET keyword (C#-only codebase).
      CA1000  — static members on generic type (intentional in Result<T>).
      CA1848  — LoggerMessage delegates (high-perf logging optimization, may revisit later).
      CA1873  — potentially expensive argument evaluation in logging (tied to CA1848).
      CS1591  — missing XML doc comment (not required on every member).
      IDE0032 — prefer auto-property (Result<T>.Value has a custom getter).
      IDE0046 — convert 'if' to conditional expression (readability preference).
      IDE0211 — top-level statements are used in Program.cs files.
      SA1117  — parameter line wrapping (overly pedantic).
      SA1611/SA1615/SA1618/SA1642 — granular param/return/ctor docs (pragmatic).
      SA1633  — file header / copyright not used.
    -->
    <NoWarn>
      $(NoWarn);CA1014;CA1819;CA2227;CA1812;CA1716;CA1000;CA1848;CA1873;CS1591;IDE0032;IDE0046;IDE0211;SA1117;SA1611;SA1615;SA1618;SA1642;SA1633
    </NoWarn>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>Luga</Company>
    <Product>Luga CoreManager</Product>
    <Copyright>Copyright © Luga $([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>

  <!-- Test overrides aplicados via Directory.Build.targets (após csproj definir IsTestProject). -->

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
