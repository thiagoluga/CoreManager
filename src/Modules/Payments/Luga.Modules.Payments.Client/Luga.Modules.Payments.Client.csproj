<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\Luga.BuildingBlocks.Client\Luga.BuildingBlocks.Client.csproj" />
    <ProjectReference Include="..\Luga.Modules.Payments.Shared\Luga.Modules.Payments.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <!-- The Razor SDK auto-registers files under the project as <Content>; we
       Remove first so the JSON ends up embedded in the DLL where
       LugaJsonStringLocalizer can read it. -->
  <ItemGroup>
    <Content Remove="Resources\**\*.json" />
    <EmbeddedResource Include="Resources\**\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
