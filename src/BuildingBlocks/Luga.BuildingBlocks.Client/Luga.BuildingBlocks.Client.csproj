<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    BuildingBlocks.Client — shared Blazor base used by every *.Client module.
    LugaPageBase, IModuleManifest, MainLayout, components, i18n pipeline.
    Rule: MUST NOT depend on Infrastructure.
  -->

  <PropertyGroup>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Luga.BuildingBlocks.IntegrationEvents\Luga.BuildingBlocks.IntegrationEvents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <!-- Embed JSON resource files into the assembly so LugaJsonStringLocalizer
       can read them via Assembly.GetManifestResourceStream — works in both
       Blazor WebAssembly and server hosts (no filesystem dependency). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*.json" />
  </ItemGroup>

</Project>
