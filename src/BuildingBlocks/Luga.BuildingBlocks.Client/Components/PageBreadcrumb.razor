@using Luga.BuildingBlocks.Client.Localization
@using Luga.BuildingBlocks.Client.Manifests
@using Luga.BuildingBlocks.Client.Navigation
@using Microsoft.AspNetCore.Components.Routing
@inject IBreadcrumbResolver Resolver
@inject IStringLocalizerFactory LocalizerFactory
@inject NavigationManager Navigation
@implements IDisposable

@*
    Drops on top of any page to render the breadcrumb trail registered by the
    owning module's manifest. Pages may pass DynamicLeaf to replace the label
    of the last dynamic segment (e.g. "Cliente João Silva").

        <PageBreadcrumb DynamicLeaf="@customer?.Name" />

    Label keys are resolved through a composite localizer that tries (in order):
      1. The page-supplied <c>Localizer</c> (per-page keys / dynamic labels)
      2. The matched manifest's own resource bundle (<c>manifest.*</c> keys)
      3. <see cref="SharedStrings"/> (<c>common.*</c> keys)
*@

<Breadcrumb Segments="_segments" Localizer="@_compositeLocalizer" Class="@Class" />

@code {
    /// <summary>Label for the trailing dynamic segment, when present.</summary>
    [Parameter] public string? DynamicLeaf { get; set; }

    /// <summary>Optional extra localizer (typically the page's <c>@L</c>).</summary>
    [Parameter] public IStringLocalizer? Localizer { get; set; }

    /// <summary>Optional CSS classes forwarded to <c>MudBreadcrumbs</c>.</summary>
    [Parameter] public string Class { get; set; } = string.Empty;

    private IReadOnlyList<BreadcrumbSegment> _segments = [];
    private IStringLocalizer? _compositeLocalizer;
    private IStringLocalizer? _sharedLocalizer;

    protected override void OnInitialized()
    {
        _sharedLocalizer = LocalizerFactory.Create(typeof(SharedStrings));
        Navigation.LocationChanged += OnLocationChanged;
        Recompute();
    }

    protected override void OnParametersSet() => Recompute();

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Recompute();
        StateHasChanged();
    }

    private void Recompute()
    {
        string path = Navigation.ToBaseRelativePath(Navigation.Uri);
        int queryIndex = path.IndexOf('?', StringComparison.Ordinal);
        if (queryIndex >= 0)
        {
            path = path[..queryIndex];
        }

        if (!path.StartsWith('/'))
        {
            path = "/" + path;
        }

        BreadcrumbMatch? match = Resolver.ResolveMatch(path, DynamicLeaf);
        _segments = match?.Segments ?? [];

        IStringLocalizer? manifestLocalizer =
            match is null ? null : LocalizerFactory.Create(match.Manifest.GetType());

        _compositeLocalizer = new ChainedStringLocalizer(Localizer, manifestLocalizer, _sharedLocalizer);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
