@inherits LayoutComponentBase

@*
    Minimal chrome for login / signup / forgot-password screens. No sidebar,
    no app bar — just a centered card around the body content.
*@

<MudLayout>
    <MudMainContent Class="d-flex align-center justify-center" Style="min-height: 100vh; background-color: var(--mud-palette-background-grey);">
        <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-12">
            <MudPaper Elevation="2" Class="pa-8">
                <div class="d-flex justify-center mb-6">
                    <MudText Typo="Typo.h4" Color="Color.Primary">Luga</MudText>
                </div>
                @Body
            </MudPaper>
        </MudContainer>
    </MudMainContent>
</MudLayout>
