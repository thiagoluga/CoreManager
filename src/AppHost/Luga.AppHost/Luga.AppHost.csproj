<Project Sdk="Aspire.AppHost.Sdk/13.3.0">

  <!--
    Luga.AppHost — Aspire orchestrator for local dev (ADR 040).
    SQL Server + Server.Host (which serves the Blazor WASM bundle on the same
    origin per CLAUDE.md §5.8). Dashboard at http://localhost:18888.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>luga-apphost</UserSecretsId>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Hosts\Luga.Server.Host\Luga.Server.Host.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.SqlServer" />
  </ItemGroup>

</Project>
