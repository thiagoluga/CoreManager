{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=LugaCore;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;",
    "Hangfire": "Server=(localdb)\\MSSQLLocalDB;Database=LugaCore;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False;"
  },
  "EntraExternalId": {
    "Authority": "https://luga.ciamlogin.com/luga.onmicrosoft.com/v2.0",
    "Audience": "api://luga-coremanager",
    "MetadataAddress": "",
    "ClockSkew": "00:02:00"
  },
  "OpenTelemetry": {
    "ServiceName": "luga-coremanager"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ]
  }
}
